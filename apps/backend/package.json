{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"env.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"env.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_ENV=test APP_STAGE=test DATABASE_URL=postgres://localhost:5432/ambulink_test node ../../node_modules/jest/bin/jest.js",
    "test:unit": "NODE_ENV=test APP_STAGE=test DATABASE_URL=postgres://localhost:5432/ambulink_test node ../../node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "NODE_ENV=test APP_STAGE=test DATABASE_URL=postgres://localhost:5432/ambulink_test node ../../node_modules/jest/bin/jest.js --watch",
    "test:cov": "NODE_ENV=test APP_STAGE=test DATABASE_URL=postgres://localhost:5432/ambulink_test node ../../node_modules/jest/bin/jest.js",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit generate && drizzle-kit migrate",
    "migrate:apply": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "seed": "npx tsx src/core/database/seed/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.2.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ambulink/eslint-config": "*",
    "@ambulink/prettier-config": "*",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/env$": "<rootDir>/../env.ts",
      "^@/(.*)$": "<rootDir>/$1",
      "^env$": "<rootDir>/../env.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
